{
  "expo": {
    "name": "Ardent",
    "slug": "ardent-mobile",
    "scheme": "ardent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ardent.mobile"
    },
    "android": {
      "package": "app.ardent.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070707",
          "image": "./assets/icon.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ardent uses the camera to photograph your work on site.",
          "photosPermission": "Ardent attaches photos of your work to the job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While you're on shift, Ardent shows your office where your van is, so emergencies go to whoever's nearest. Nothing is shared off shift."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
