{
  "expo": {
    "name": "Ardent",
    "slug": "ardent-mobile",
    "scheme": "ardent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0D",
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.ardent.mobile" },
    "android": { "package": "app.ardent.mobile", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#0B0C0D", "image": "./assets/icon.png", "imageWidth": 1 }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
