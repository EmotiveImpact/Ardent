# ── Supabase (frontend) ────────────────────────────────────────
# Public — safe to ship in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App ────────────────────────────────────────────────────────
# Public origin used in transactional emails (digest, invites, etc.)
APP_URL=https://app.facilities-os.com
# Display-only — surfaces in the UI to remind admins which Resend
# domain the system is sending from. Not used for actual auth.
VITE_RESEND_DOMAIN=facilities-os.com

# ── Resend (server-side, Edge Functions only) ─────────────────
# DO NOT prefix these with VITE_ — they must never reach the client.
# Set in Supabase Dashboard > Project Settings > Edge Functions > Secrets.
RESEND_API_KEY=
# Optional override of the From: header for the weekly digest.
# Default: 'Facilities OS <reports@facilities-os.com>'
DIGEST_FROM_EMAIL=

# ── Supabase service role (server-side only) ──────────────────
# Used by edge functions (weekly-digest) for cross-user reads.
# NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (server-side, Edge Functions only) ────────────────
# DO NOT prefix any of these with VITE_ — they must never reach
# the browser bundle. Set them in:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# Required for the `stripe-checkout`, `stripe-webhook`, and
# `stripe-portal` edge functions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (one per paid plan). These are the long
# `price_…` IDs you copy from the Stripe Dashboard after creating
# a recurring monthly product. Enterprise has no price — sales-led.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Optional — only set if you ever want to do a client-side
# redirect-to-checkout via Stripe.js. Currently unused; the app
# uses the URL returned from the `stripe-checkout` edge function.
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── Sentry (observability) ─────────────────────────────────────
# Public DSN — safe to ship. Init is gated on this var; leave empty
# to disable Sentry entirely (dev / local builds).
VITE_SENTRY_DSN=

# Build-time only. Used by @sentry/vite-plugin to upload source maps.
# DO NOT prefix with VITE_ — must never reach the browser bundle.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional — overrides the default release tag (defaults to "<pkg>@<version>"
# read from package.json at build time). Useful in CI where the commit SHA
# makes a better release identifier.
VITE_APP_VERSION=

# ── Anthropic (server-side, Edge Functions only) ──────────────
# Used by the `ai-suggest-compliance` edge function (Wave 9 — LLM
# compliance type suggester) and any future AI features.
#
# DO NOT prefix with VITE_ — the client never sees this key.
# Set in Supabase Dashboard → Project Settings → Edge Functions → Secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# When unset, the suggester UI hides itself silently — Facilities OS
# remains fully functional without an Anthropic account.
#
# Cost note: we deliberately use claude-haiku-4-5-20251001 (Haiku 4.5),
# the cheapest 4.5-family model. A typical compliance suggestion is
# ~250 input + ~150 output tokens — well under 1¢ per call. The
# `ai_usage_quotas` table caps each org at 1 000 calls/month by
# default; adjust there for paid customers.
ANTHROPIC_API_KEY=

# ── SSO (Microsoft Entra + Google Workspace) ─────────────────
# No new client env vars are required — Supabase Auth handles the
# OAuth round-trip. SSO providers are configured in:
#   Supabase Dashboard → Authentication → Providers → Azure
#   Supabase Dashboard → Authentication → Providers → Google
# Set the client ID, client secret, and the redirect URL there.
# The redirect URL the app uses is: <APP_URL>/auth/sso/callback
# (Supabase requires you to also add the Supabase callback URL —
#  e.g. https://<project>.supabase.co/auth/v1/callback — to the
#  identity provider's allowed redirect URIs.)
#
# Domain → organisation mappings live in `sso_domain_mappings`
# (see migration 00020_sso.sql) and are managed at:
#   /dashboard/integrations/sso

# ── Slack (Wave 9 — Slack notifications integration) ──────────
# Used by the `slack-oauth` and `slack-post-notification` edge
# functions to authenticate as the Slack app and exchange OAuth
# v2 codes. Set in Supabase Dashboard → Edge Functions → Secrets:
#   supabase secrets set SLACK_CLIENT_ID=...
#   supabase secrets set SLACK_CLIENT_SECRET=...
#
# Scopes requested: chat:write incoming-webhook channels:read
# Redirect URL: <APP_URL>/dashboard/integrations/slack
# (must match exactly in your Slack app's "OAuth & Permissions" tab)
#
# Outbound only — we post via the user-supplied incoming webhook.
# Slack does NOT call back into us, so SLACK_SIGNING_SECRET is
# documented for future use (e.g. interactive components, slash
# commands) but not required for v1.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Public — surfaced to the browser so the OAuth start button can
# render its state. Without this, the Slack settings page shows a
# "not configured" warning. Same value as SLACK_CLIENT_ID.
VITE_SLACK_CLIENT_ID=

# ── Deploy Status DX Panel (server-side, Edge Functions only) ─
# Used by the `check-deploy-status` edge function which surfaces
# failed Vercel/GitHub deploys in the in-app DX panel
# (super_admin dashboard banner + /dashboard/health banner +
# dev-mode bottom-right pill).
#
# GITHUB_TOKEN — REQUIRED for SiteSentriq (the repo is private and
# anonymous calls return 404). Use a GitHub fine-grained PAT or
# classic PAT with the following scope:
#   - Classic PAT: `repo:status` is enough for *public* repos.
#                  Private repos require the full `repo` scope.
#   - Fine-grained: `Deployments: read` + `Metadata: read` on the
#                   EmotiveImpact/SiteSentriq repository.
# Set via `supabase secrets set GITHUB_TOKEN=...`. Never prefix
# with VITE_ — it must never reach the client bundle.
GITHUB_TOKEN=

# GITHUB_REPO — owner/name slug. Defaults to EmotiveImpact/SiteSentriq
# if unset. Override only when running against a fork.
GITHUB_REPO=EmotiveImpact/SiteSentriq

# ── Browserless (Wave 13C — real PDF certificate rendering) ───
# Used by the `generate-certificate` edge function to convert the
# rendered certificate HTML into a binary PDF via Browserless's
# `/pdf` endpoint. The PDF is uploaded to
# `certificates/<org_id>/<cert_id>.pdf` alongside the HTML record.
#
# If unset, certificates ship as HTML only — the feature degrades
# gracefully and the UI's Download button will offer the saved HTML
# instead. Get a free tier token at https://browserless.io/.
#
# Set in Supabase Dashboard → Edge Functions → Secrets:
#   supabase secrets set BROWSERLESS_TOKEN=...
# Never prefix with VITE_ — must never reach the browser bundle.
#
# Future-proof: a self-hosted Vercel Function with Playwright can be
# swapped in by changing the fetch URL in
# `supabase/functions/generate-certificate/index.ts` — the request
# shape ({ html, options: { format, printBackground, margin } })
# matches Playwright's `page.pdf()` signature.
BROWSERLESS_TOKEN=

# ── Web Push notifications (VAPID) ────────────────────────────
# Wave 13D — backend for `send-push` edge function. The VAPID
# (Voluntary Application Server Identification) keypair signs
# Web Push messages so push servers (Apple/Mozilla/Google) trust
# they came from this origin.
#
# Generate ONE keypair (shared across the org — not per-user):
#   npx web-push generate-vapid-keys --json
#
# Then set:
#   1. VAPID_PUBLIC_KEY  — server secret (Edge Function env)
#      `supabase secrets set VAPID_PUBLIC_KEY=<base64url>`
#   2. VITE_VAPID_PUBLIC_KEY — same value, but exposed to the
#      browser so `pushManager.subscribe()` can use it
#   3. VAPID_PRIVATE_KEY — server secret ONLY (NEVER VITE_-prefix)
#      `supabase secrets set VAPID_PRIVATE_KEY=<base64url>`
#   4. VAPID_SUBJECT — required by the Web Push spec; mailto: URL
#      that push servers can contact if your origin misbehaves
#      `supabase secrets set VAPID_SUBJECT=mailto:notifications@haumea.com`
#
# When VAPID keys are unset, the `send-push` edge function returns
# `{ unconfigured: true }` and the in-app notification flow continues
# silently — push delivery just doesn't fire. The rest of the app
# remains fully functional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@haumea.com

# Public — surfaced to the browser so PushManager.subscribe() can
# pass it as `applicationServerKey`. MUST equal VAPID_PUBLIC_KEY
# (same value, just exposed to the bundle).
VITE_VAPID_PUBLIC_KEY=

# Optional — force-disable push entirely for a tenant
# (e.g. customer doesn't want browser-level notifications).
# Default behaviour: enabled when not set.
# VITE_FEATURE_PUSH=false
